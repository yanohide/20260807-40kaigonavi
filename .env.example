NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# 本番の正式URL（sitemap / robots / metadata）
NEXT_PUBLIC_SITE_URL=https://sonocafe.xyz
# Google Analytics 4 測定ID（G- で始まる）。未設定時はタグを出力しない
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SANITY_API_TOKEN=
# 下書きプレビュー（Next 側の合言葉）
SANITY_PREVIEW_SECRET=
# Studio（npm run studio）から渡す合言葉・URL
SANITY_STUDIO_PREVIEW_SECRET=
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
# 記事編集は npm run studio → http://localhost:3333
# macOS 13.5+ のみ。12.x で OpenNext dev バインディングを試す場合は 1
# OPENNEXT_DEV=0
